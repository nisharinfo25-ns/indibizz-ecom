# IndiaBizz customer website environment.
# Copy to `.env.local` and fill with the project values. Only NEXT_PUBLIC_*
# values reach the browser; never put a service-role key in this file.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
