# IndiaBizz Edge Functions environment.
# Copy to `supabase/functions/.env` for local runs, or set these as project
# secrets for remote deployment (`supabase secrets set --env-file ...`).
# NEVER commit real secrets.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Comma-separated origins allowed to call Edge Functions (CORS).
APP_ORIGIN=http://localhost:3000

# Long random values. Generate with: openssl rand -hex 32
BOOTSTRAP_SECRET=CHANGE_ME_LONG_RANDOM
WORKER_SECRET=CHANGE_ME_LONG_RANDOM

# Firebase Cloud Messaging service account JSON (raw JSON on one line, or base64).
# Leave empty to keep push disabled; in-app notifications still work.
FCM_SERVICE_ACCOUNT_JSON=
